NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side only. Never expose this value through a NEXT_PUBLIC_ variable.
SUPABASE_SECRET_KEY=

# Required for a reliable production Google Books fallback. Without it,
# LumiScore still attempts the public endpoint and fails safely on quota errors.
# Server-side only. Never prefix this with NEXT_PUBLIC_.
GOOGLE_BOOKS_API_KEY=
