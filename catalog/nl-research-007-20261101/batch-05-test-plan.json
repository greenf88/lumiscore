    {
      "relation": "catalog_work_descriptions",
      "ref": "description:103",
      "key": {
        "work_id": 978100044,
        "language": "nl"
      },
      "before": null,
      "after": {
        "work_id": 978100044,
        "language": "nl",
        "bound_author_id": 978300029,
        "text": "Een vader en zijn zoontje trekken naar het zuiden door een Amerikaans landschap dat na een ramp vrijwel levenloos is geworden. As en kou maken iedere stap zwaar, terwijl hun belangrijkste opdracht eenvoudig blijft: overleven zonder elkaar kwijt te raken. Buiten hun onderlinge band is weinig houvast over. Cormac McCarthy volgt hoe liefde tussen ouder en kind stand probeert te houden wanneer de vertrouwde beschaving is verdwenen.",
        "source_type": "official_catalog",
        "source_name": "Bibliografische bron; oorspronkelijke gecontroleerde samenvatting",
        "source_url": "https://metadata.isbn.nl/108039/de-weg.html",
        "provenance": "original_source_reviewed_summary",
        "review_status": "approved",
        "reviewed_at": "2026-11-01T21:37:32Z",
        "review_batch": "nl007-reviewed-batch-05-20261101",
