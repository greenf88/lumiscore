    {
      "relation": "catalog_work_descriptions",
      "ref": "description:15",
      "key": {
        "work_id": 15,
        "language": "nl"
      },
      "before": null,
      "after": {
        "work_id": 15,
        "language": "nl",
        "bound_author_id": 12,
        "text": "In een verre toekomst houden de Wereldchefs de bevolking tevreden door mensen vanaf hun ontstaan te sturen. Genetische manipulatie, aangeleerd gedrag en middelen voor ontspanning maken burgers tot voorspelbare consumenten. Bernard Marx voelt desondanks dat er iets aan zijn bestaan ontbreekt. Een bezoek aan een reservaat waar oudere levensvormen zijn blijven bestaan, confronteert hem met een andere werkelijkheid en met de prijs van het georganiseerde geluk.",
        "source_type": "official_catalog",
        "source_name": "Bureau ISBN; oorspronkelijke gecontroleerde samenvatting",
