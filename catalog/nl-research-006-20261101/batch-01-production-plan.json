    {
      "relation": "catalog_work_descriptions",
      "ref": "description:1490",
      "key": {
        "work_id": 1490,
        "language": "nl"
      },
      "before": null,
      "after": {
        "work_id": 1490,
        "language": "nl",
        "bound_author_id": 399,
        "text": "Politiecommissaris Nash probeert te herstellen van een schietpartij. Zijn vertrouwde zelfverzekerdheid is aangetast door nachtmerries en paniekaanvallen, maar hij laat anderen nauwelijks merken hoe het met hem gaat. Buurvrouw Lina kijkt door die houding heen, hoewel ze niet van plan is lang in Knockemout te blijven. Wanneer ze op elkaar aangewezen raken, worden hun plannen ingewikkelder en moeten ze bepalen hoeveel ruimte ze de ander in hun leven willen geven.",
        "source_type": "official_catalog",
        "source_name": "Bureau ISBN; oorspronkelijke gecontroleerde samenvatting",
